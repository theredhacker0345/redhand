{
  "name": "redhand-mcp",
  "version": "0.1.0",
  "description": "The agent's hand inside your browser - Manus-grade browser control for AI agents via raw CDP + MCP. Your real browser, your sessions, humanized input.",
  "license": "BUSL-1.1",
  "author": "theredhacker0345",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theredhacker0345/redhand.git"
  },
  "homepage": "https://github.com/theredhacker0345/redhand#readme",
  "keywords": [
    "mcp",
    "mcp-server",
    "browser-automation",
    "cdp",
    "devtools-protocol",
    "ai-agents",
    "browser-control",
    "security-research"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "redhand-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@redhand/core": "workspace:*",
    "@redhand/humanize": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
